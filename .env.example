# Copy to .env and change the password. .env is gitignored — never commit it.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=gas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gas
# Host port published on 127.0.0.1 only (5432 is often taken by other installs)
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1

# --- Backend (FastAPI) ---
# Comma-separated list of browser origins allowed by CORS (no wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Non-public directory for original PDFs (used from Day 2)
STORAGE_DIR=../storage

# --- Local AI (Ollama, used from Day 4; leave empty until then) ---
OLLAMA_BASE_URL=

# --- Frontend (Vite) — put in frontend/.env.local if it differs ---
# VITE_API_BASE_URL=http://localhost:8000
